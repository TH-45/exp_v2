<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jh.exp.sys.mapper.dic.SysDictMapper">

    <select id="listByDictCode" resultType="jh.exp.sys.entity.dic.SysDictItem"
            parameterType="java.lang.String">
        select *
        from sys_dict_item i
        left join sys_dict_type t on i.dict_type_code = t.dict_type_code
        where dict_type_code = #{dictTypeCode}
        order by sort_no
    </select>
</mapper>