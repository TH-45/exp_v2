<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="jh.exp.sys.core.mapper.dic.SysDictMapper">

    <select id="listByDictCode" resultType="jh.exp.sys.core.entity.dic.SysDictItem"
            parameterType="java.lang.String">
        select i.*
        from sys_dict_item i
        left join sys_dict_type t on i.dict_code = t.dict_code
        where i.dict_code = #{dictCode}
        order by i.sort_no
    </select>
</mapper>