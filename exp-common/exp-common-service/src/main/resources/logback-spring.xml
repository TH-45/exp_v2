<configuration scan="true" scanPeriod="60 seconds">

    <!-- 从 Spring 环境读取可覆盖的日志路径/文件名，缺省使用应用名 -->
    <springProperty name="LOG_PATH" source="LOG_PATH" defaultValue="logs"/>
    <springProperty name="LOG_FILE_PROP" source="LOG_FILE"/>
    <springProperty name="APP_NAME" source="spring.application.name" defaultValue="app"/>
    <!-- 优先 LOG_FILE，其次 spring.application.name，最后 app -->
    <property name="LOG_FILE" value="${LOG_FILE_PROP:-${APP_NAME}}"/>

    <contextName>${LOG_FILE}</contextName>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 滚动文件输出：每天一个文件，保留 30 天 -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/${LOG_FILE}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/${LOG_FILE}.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 休眠监控：超过一定时间没有业务日志输出时打印醒目提示 -->
    <appender name="IDLE_MONITOR" class="jh.exp.common.logging.IdleMonitorAppender">
        <!-- 使用 LOG_FILE 作为服务标识，例如 auth / bid-contract / project 等 -->
        <serviceName>${LOG_FILE}</serviceName>
        <!-- 判定休眠的阈值（秒），默认 120，可按需调整 -->
        <idleThresholdSeconds>120</idleThresholdSeconds>
        <!-- 检查间隔（秒），默认 30，可按需调整 -->
        <checkIntervalSeconds>30</checkIntervalSeconds>
    </appender>

    <!-- 业务包可以单独调试级别（如需） -->
    <logger name="jh.exp" level="INFO"/>

    <!-- 根日志级别 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="IDLE_MONITOR"/>
    </root>

</configuration>


