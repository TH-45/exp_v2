<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- 继承统一依赖管理模块 exp-dependency（含 MyBatis-Plus 等公共依赖） -->
	<parent>
		<groupId>jh.exp.dependency</groupId>
		<artifactId>exp-dependency</artifactId>
		<version>1.0.0</version>
		<relativePath>../exp-dependency/pom.xml</relativePath>
	</parent>

	<groupId>jh.exp.common</groupId>
	<artifactId>exp-common</artifactId>
	<version>1.0.0</version>
	<name>${project.artifactId}</name>
	<description>exp-common</description>

	<packaging>pom</packaging>

	<properties>
		<java.version>17</java.version>
		<spring-cloud.version>2023.0.2</spring-cloud.version>
	</properties>

	<modules>
		<module>exp-common-client</module>
		<module>exp-common-core</module>
		<module>exp-common-service</module>
	</modules>


	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
